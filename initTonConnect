// ==========================================
// CRITICAL FIX: Override window.open BEFORE anything else
// ==========================================
const originalOpen = window.open;
window.open = function(url, target, features) {
    if (url && (
        url.includes('tonkeeper') || 
        url.includes('tonhub') ||
        url.includes('mytonwallet') ||
        url.includes('wallet.tg') ||
        url.includes('t.me/wallet') ||
        url.includes('tc://') ||
        url.includes('ton://')
    )) {
        return originalOpen.call(window, url, '_blank', features);
    }
    return originalOpen.call(window, url, target, features);
};

let tonConnectUI = null;

function initTonConnect() {
    try {
        if (!window.TON_CONNECT_UI?.TonConnectUI) {
            setTimeout(initTonConnect, 500);
            return;
        }

        const container = document.getElementById('ton-connect');
        if (!container) return;

        container.innerHTML = '';

        tonConnectUI = new window.TON_CONNECT_UI.TonConnectUI({
            manifestUrl: 'https://goldhuntpro.vercel.app/tonconnect-manifest.json',
            buttonRootId: 'ton-connect'
        });

        if (window.Telegram?.WebApp) {
            const tg = window.Telegram.WebApp;
            tg.ready();
            tg.expand();

            tonConnectUI.uiOptions = {
                language: 'en',
                uiPreferences: {
                    theme: 'DARK'
                },
                actionsConfiguration: {
                    returnStrategy: 'none',
                    twaReturnUrl: 'https://t.me/Goldhunt101bot?startapp=main',
                    skipRedirectToWallet: 'ios'
                }
            };
        }

        // CRITICAL: Set connect request parameters
        tonConnectUI.setConnectRequestParameters({
            state: 'ready',
            value: {
                tonProof: generateNonce()
            }
        });

        tonConnectUI.onStatusChange(async (wallet) => {
            if (wallet?.account) {
                await verifyWalletWithBackend(wallet);
            } else {
                handleWalletDisconnect();
            }
        });

        document.getElementById('walletFallback').style.display = 'none';

    } catch (error) {
        console.error('TON Connect error:', error);
        document.getElementById('walletFallback').style.display = 'block';
        setTimeout(initTonConnect, 3000);
    }
}

function generateNonce() {
    return Array.from(crypto.getRandomValues(new Uint8Array(16)))
        .map(b => b.toString(16).padStart(2, '0'))
        .join('');
}

async function connectWalletManual() {
    if (!tonConnectUI) {
        initTonConnect();
        setTimeout(connectWalletManual, 1000);
        return;
    }

    try {
        await tonConnectUI.openModal();
    } catch (error) {
        console.error('Manual connect error:', error);
        try {
            await tonConnectUI.connectWallet();
        } catch (e) {
            console.error('Direct connect fallback failed:', e);
        }
    }
}

async function verifyWalletWithBackend(wallet) {
    try {
        const response = await fetch('https://your-backend-url.com/api/wallet/connect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                telegramId: window.telegramId,
                proof: wallet.connectItems?.tonProof,
                account: wallet.account
            })
        });

        const result = await response.json();

        if (result.success) {
            gameState.walletAddress = result.address;
            gameState.walletConnected = true;
            localStorage.setItem('goldhunt_walletAddress', result.address);
            localStorage.setItem('goldhunt_walletConnected', 'true');
            showToast('✅ Wallet connected!');
            updateProfilePage();
        } else {
            showToast('❌ Verification failed');
            tonConnectUI.disconnect();
        }

    } catch (error) {
        console.error('Backend error:', error);
        showToast('❌ Server error');
    }
}

function handleWalletDisconnect() {
    fetch('https://your-backend-url.com/api/wallet/disconnect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ telegramId: window.telegramId })
    }).catch(console.error);

    gameState.walletAddress = null;
    gameState.walletConnected = false;
    localStorage.removeItem('goldhunt_walletAddress');
    localStorage.removeItem('goldhunt_walletConnected');
    showToast('🔌 Wallet disconnected');
    updateProfilePage();
}
