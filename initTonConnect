// ==========================================
// FIXED TON CONNECT
// ==========================================
function initTonConnect() {
    console.log('TonConnect init started');
    
    if (!window.TON_CONNECT_UI) {
        console.log('TON_CONNECT_UI not loaded, retrying...');
        setTimeout(initTonConnect, 1000);
        return;
    }

    const container = document.getElementById('ton-connect');
    if (!container) {
        console.error('TonConnect container #ton-connect not found');
        return;
    }

    try {
        // Clear previous attempts
        container.innerHTML = '';
        
        // CRITICAL: Your manifest must be publicly accessible at this URL
        // Create this file at: https://goldhunt101.vercel.app/tonconnect-manifest.json
        const manifestUrl = 'https://goldhunt101.vercel.app/tonconnect-manifest.json';
        
        // Test if manifest is accessible first
        fetch(manifestUrl)
            .then(response => {
                if (!response.ok) {
                    console.error('Manifest not accessible:', response.status);
                    showToast('⚠️ Wallet config error - contact support');
                    return null;
                }
                return response.json();
            })
            .then(manifest => {
                if (!manifest) return;
                console.log('Manifest loaded:', manifest);
                
                // Initialize TON Connect UI
                tonConnectUI = new window.TON_CONNECT_UI.TonConnectUI({
                    manifestUrl: manifestUrl,
                    buttonRootId: 'ton-connect'
                });
                
                // CRITICAL for Telegram Mini App: set return URL
                if (window.Telegram?.WebApp) {
                    const tg = window.Telegram.WebApp;
                    tonConnectUI.uiOptions = {
                        twaReturnUrl: tg.initDataUnsafe?.start_param 
                            ? `https://t.me/Goldhunt101bot?startapp=${tg.initDataUnsafe.start_param}`
                            : 'https://t.me/Goldhunt101bot'
                    };
                }
                
                // Handle wallet connection status
                tonConnectUI.onStatusChange(async (wallet) => {
                    if (wallet) {
                        console.log('Wallet connected:', wallet.account.address);
                        gameState.walletAddress = wallet.account.address;
                        gameState.walletConnected = true;
                        localStorage.setItem('goldhunt_walletAddress', wallet.account.address);
                        localStorage.setItem('goldhunt_walletConnected', 'true');
                        showToast('✅ Wallet Connected!');
                        updateProfilePage();
                        
                        // Save to Firebase
                        if (window.firestoreDB && gameState.telegramUserId) {
                            try {
                                const userRef = window.firestoreDoc(window.firestoreDB, 'users', gameState.telegramUserId.toString());
                                await window.firestoreUpdateDoc(userRef, {
                                    walletAddress: wallet.account.address,
                                    lastUpdated: window.serverTimestamp()
                                });
                            } catch (e) {
                                console.error('Error saving wallet:', e);
                            }
                        }
                    } else {
                        console.log('Wallet disconnected');
                        gameState.walletAddress = null;
                        gameState.walletConnected = false;
                        localStorage.removeItem('goldhunt_walletAddress');
                        localStorage.removeItem('goldhunt_walletConnected');
                        showToast('🔌 Wallet Disconnected');
                        updateProfilePage();
                    }
                });
                
                // Try to restore existing connection
                tonConnectUI.connectionRestored.then((restored) => {
                    console.log('Connection restored:', restored);
                });
                
            })
            .catch(error => {
                console.error('Manifest fetch error:', error);
                showToast('⚠️ Wallet service unavailable');
            });

    } catch (error) {
        console.error('TON Connect fatal error:', error);
        showToast('❌ Wallet connection failed');
    }
}
