// ==========================================
// CALL THIS FUNCTION: processReferralAPI()
// ==========================================

async function processReferralAPI(newUserId, referralCode, userName, username) {
    try {
        const API_URL = 'https://your-vercel-app.vercel.app'; // Change this!
        
        const response = await fetch(`${API_URL}/api/referral/process`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                newUserId: newUserId,
                referralCode: referralCode,
                newUserName: userName,
                newUserUsername: username
            })
        });
        
        const result = await response.json();
        
        if (result.success) {
            console.log('✅ Referral processed via API:', result);
            return { success: true, bonus: result.referrerBonus };
        } else {
            console.log('❌ API referral failed:', result.error);
            // Fallback to direct Firebase
            return await recordReferralAtomic(referralCode, newUserId, username || userName);
        }
        
    } catch (error) {
        console.error('API connection failed:', error);
        // Fallback to direct Firebase processing
        return await recordReferralAtomic(referralCode, newUserId, username || userName);
    }
}
